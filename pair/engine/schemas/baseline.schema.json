{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pair.invalid/schemas/baseline.schema.json",
  "title": "pair/rules/baseline.toml",
  "x-spec": "15.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scopes": {
      "type": "object",
      "description": "Keyed by scope path. \"_repo\" is the fallback scope.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "branch", "measured_at"],
        "properties": {
          "line": { "type": "number", "minimum": 0, "maximum": 100 },
          "branch": { "type": "number", "minimum": 0, "maximum": 100 },
          "measured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "lowered_by": { "type": "string", "pattern": "^@[\\w.-]+$" },
          "lowered_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
