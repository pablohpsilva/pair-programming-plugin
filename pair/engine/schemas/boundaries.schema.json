{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pair.invalid/schemas/boundaries.schema.json",
  "title": "pair/rules/boundaries.toml",
  "x-spec": "10.7",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "import_names", "may_depend_on"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "import_names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "may_depend_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Module keys. That each one exists in modules is checked in schema.py."
          }
        }
      }
    },
    "import_patterns": {
      "type": "object",
      "description": "Keyed by file extension including the dot. Regex group 1 is the imported name.",
      "propertyNames": { "pattern": "^\\.[A-Za-z0-9]+$" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      }
    }
  }
}
