#!/usr/bin/env python3
"""pair — the engineer decides, the agent proposes.

This is the single entry point (SPEC 11). It adds the engine's `lib/` to the path and hands over to
`pair.cli`, so the tool runs from a checkout with nothing installed.
"""

import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        f"pair needs Python 3.11 or newer (this is {sys.version.split()[0]}): it reads TOML with "
        f"the standard library's tomllib and installs nothing (D2).\n")
    raise SystemExit(2)

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from pair.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
